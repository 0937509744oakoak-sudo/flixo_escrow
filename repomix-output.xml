<file path="scripts/generate_vapid_keys.php">
<?php
/**
 * Generate a VAPID (Voluntary Application Server Identification) EC key pair
 * for Web Push. Run once, then paste the output into .env.
 *
 * Usage: php scripts/generate_vapid_keys.php
 */

function base64UrlEncode(string $data): string
{
    return rtrim(strtr(base64_encode($data), '+/', '-_'), '=');
}

/** Pad/trim a big-endian integer to exactly $len bytes. */
function fixedLengthBytes(string $bin, int $len): string
{
    $bin = ltrim($bin, "\x00");
    if (strlen($bin) > $len) {
        $bin = substr($bin, -$len);
    }
    return str_pad($bin, $len, "\x00", STR_PAD_LEFT);
}

$config = [
    'private_key_type' => OPENSSL_KEYTYPE_EC,
    'curve_name' => 'prime256v1',
];

$res = openssl_pkey_new($config);
if ($res === false) {
    fwrite(STDERR, "Failed to generate EC key pair: " . openssl_error_string() . "\n");
    exit(1);
}

$details = openssl_pkey_get_details($res);
if (!$details || !isset($details['ec']['x'], $details['ec']['y'], $details['ec']['d'])) {
    fwrite(STDERR, "Failed to read EC key details.\n");
    exit(1);
}

$x = fixedLengthBytes($details['ec']['x'], 32);
$y = fixedLengthBytes($details['ec']['y'], 32);
$d = fixedLengthBytes($details['ec']['d'], 32);

// Uncompressed EC point format (0x04 || X || Y) — what browsers expect as applicationServerKey.
$publicKey = base64UrlEncode("\x04" . $x . $y);
$privateKey = base64UrlEncode($d);

echo "VAPID key pair generated.\n\n";
echo "Add these to your .env:\n\n";
echo "VAPID_PUBLIC_KEY={$publicKey}\n";
echo "VAPID_PRIVATE_KEY={$privateKey}\n";
echo "VAPID_SUBJECT=mailto:support@yourdomain.com\n\n";
echo "VAPID_PUBLIC_KEY is also embedded client-side (safe to expose); VAPID_PRIVATE_KEY must stay secret.\n";
</file>

<file path="scripts/migrate_images_to_r2.php">
<?php
/**
 * Backfill existing local chat images to Cloud Object Storage (Cloudflare R2 / S3).
 *
 * Safe to run repeatedly (idempotent): only touches rows whose image_path is
 * still a local filename (NOT LIKE 'http%'). Missing local files are skipped,
 * never blanked, so no data is lost.
 *
 * Usage:
 *   php scripts/migrate_images_to_r2.php            # migrate up to 500 rows
 *   php scripts/migrate_images_to_r2.php --dry-run  # preview only, no writes
 *   php scripts/migrate_images_to_r2.php --limit=1000
 *
 * Recommended rollout:
 *   Phase 1: deploy code (dual-read already works — old files still display)
 *   Phase 2: run this script in batches until "remaining" reaches 0
 *   Phase 3: verify sample URLs, then archive the local uploads/ folder
 */

if (PHP_SAPI !== 'cli') {
    http_response_code(403);
    exit("This script must be run from the command line.\n");
}

require_once __DIR__ . '/../includes/db.php';
require_once __DIR__ . '/../includes/config.php';
require_once __DIR__ . '/../includes/order_helper.php';
require_once __DIR__ . '/../includes/ObjectStorage.php';

// --- parse args ---
$dryRun = in_array('--dry-run', $argv, true);
$limit = 500;
foreach ($argv as $arg) {
    if (preg_match('/^--limit=(\d+)$/', $arg, $m)) {
        $limit = max(1, (int) $m[1]);
    }
}

$storage = new ObjectStorage();
if (!$storage->isConfigured()) {
    fwrite(STDERR, "Object storage (S3_*) is not configured. Set env vars first.\n");
    exit(1);
}

$finfo   = new finfo(FILEINFO_MIME_TYPE);
$mimeExt = ['image/jpeg' => 'jpg', 'image/png' => 'png', 'image/webp' => 'webp'];

// Count remaining before we start.
$remainRes = $conn->query(
    "SELECT COUNT(*) AS c FROM messages WHERE image_path <> '' AND image_path IS NOT NULL AND image_path NOT LIKE 'http%'"
);
$remaining = $remainRes ? (int) $remainRes->fetch_assoc()['c'] : 0;
echo "Rows still on local storage: {$remaining}\n";
echo ($dryRun ? "[DRY RUN] " : "") . "Processing up to {$limit} rows...\n\n";

$rows = $conn->query(
    "SELECT id, image_path FROM messages
      WHERE image_path <> '' AND image_path IS NOT NULL AND image_path NOT LIKE 'http%'
      ORDER BY id ASC
      LIMIT " . (int) $limit
);

if (!$rows || $rows->num_rows === 0) {
    echo "Nothing to migrate. Done.\n";
    exit(0);
}

$upd = $conn->prepare("UPDATE messages SET image_path = ? WHERE id = ?");

$migrated = 0;
$missing  = 0;
$failed   = 0;
$uploadsRoot = rtrim(flixoUploadsRoot(), "/\\");

while ($row = $rows->fetch_assoc()) {
    $id   = (int) $row['id'];
    $name = basename((string) $row['image_path']);       // local chat images live in uploads root
    $local = $uploadsRoot . DIRECTORY_SEPARATOR . $name;

    if (!is_file($local)) {
        $missing++;
        echo "  [skip] id={$id} file missing: {$name}\n";
        continue;
    }

    $mime = $finfo->file($local);
    if (!isset($mimeExt[$mime])) {
        $missing++;
        echo "  [skip] id={$id} unsupported mime: {$mime}\n";
        continue;
    }

    $objectKey = 'chat/' . pathinfo($name, PATHINFO_FILENAME) . '.' . $mimeExt[$mime];

    if ($dryRun) {
        echo "  [dry ] id={$id} {$name} -> {$objectKey}\n";
        $migrated++;
        continue;
    }

    try {
        $url = $storage->put($local, $objectKey, $mime);
        $upd->bind_param('si', $url, $id);
        $upd->execute();
        $migrated++;
        echo "  [ok  ] id={$id} -> {$url}\n";
    } catch (Throwable $e) {
        $failed++;
        error_log("migrate_images_to_r2 id={$id} failed: " . $e->getMessage());
        echo "  [fail] id={$id}: " . $e->getMessage() . "\n";
    }
}

echo "\nDone. migrated={$migrated} missing={$missing} failed={$failed}\n";
if (!$dryRun && $remaining > $migrated) {
    echo "Run again to continue (remaining ~" . ($remaining - $migrated) . ").\n";
}
</file>

<file path="scripts/migrate_products_to_r2.php">
<?php
/**
 * Backfill existing local product images to Cloud Object Storage (R2/S3).
 *
 * Product images are PUBLIC: we store the full public URL in the DB.
 * Product::imageUrl() already returns http(s) values as-is, so display keeps
 * working for both migrated (URL) and legacy (local filename) rows.
 *
 * Covers BOTH products.image_path (legacy single image) and product_images
 * (gallery). Safe to run repeatedly (idempotent): only touches rows whose value
 * is not already an http URL. Missing local files are skipped, never blanked.
 *
 * Run migration 026 first (widens columns to VARCHAR(512)).
 *
 * Usage:
 *   php scripts/migrate_products_to_r2.php --dry-run
 *   php scripts/migrate_products_to_r2.php
 *   php scripts/migrate_products_to_r2.php --limit=1000
 */

if (PHP_SAPI !== 'cli') {
    http_response_code(403);
    exit("This script must be run from the command line.\n");
}

require_once __DIR__ . '/../includes/db.php';
require_once __DIR__ . '/../includes/config.php';
require_once __DIR__ . '/../includes/order_helper.php';
require_once __DIR__ . '/../includes/ObjectStorage.php';

$dryRun = in_array('--dry-run', $argv, true);
$limit = 500;
foreach ($argv as $arg) {
    if (preg_match('/^--limit=(\d+)$/', $arg, $m)) {
        $limit = max(1, (int) $m[1]);
    }
}

$storage = new ObjectStorage();
if (!$storage->isConfigured()) {
    fwrite(STDERR, "Object storage (S3_*) is not configured. Set env vars first.\n");
    exit(1);
}

$finfo = new finfo(FILEINFO_MIME_TYPE);

/**
 * Migrate one table/column of public product images. Stores the public URL back.
 * A per-row cache avoids re-uploading the same physical file twice (products
 * and product_images can reference the same filename).
 *
 * @param array<string,string> $urlCache basename => already-uploaded URL
 */
function migrateProductColumn(
    mysqli $conn,
    ObjectStorage $storage,
    finfo $finfo,
    string $table,
    string $col,
    bool $dryRun,
    int $limit,
    array &$urlCache
): void {
    $countRes = $conn->query(
        "SELECT COUNT(*) AS c FROM {$table}
          WHERE {$col} IS NOT NULL AND {$col} <> '' AND {$col} NOT LIKE 'http%'"
    );
    $remaining = $countRes ? (int) $countRes->fetch_assoc()['c'] : 0;
    echo "[{$table}.{$col}] on local storage: {$remaining}\n";

    $rows = $conn->query(
        "SELECT id, {$col} AS ref FROM {$table}
          WHERE {$col} IS NOT NULL AND {$col} <> '' AND {$col} NOT LIKE 'http%'
          ORDER BY id ASC
          LIMIT " . (int) $limit
    );
    if (!$rows || $rows->num_rows === 0) {
        echo "  nothing to migrate.\n";
        return;
    }

    $localDir = rtrim(flixoUploadsSubdir('products'), "/\\");
    $upd = $conn->prepare("UPDATE {$table} SET {$col} = ? WHERE id = ?");

    $migrated = 0; $missing = 0; $failed = 0;
    while ($row = $rows->fetch_assoc()) {
        $id   = (int) $row['id'];
        $name = basename((string) $row['ref']);
        $local = $localDir . DIRECTORY_SEPARATOR . $name;

        if (!is_file($local)) {
            $missing++;
            echo "  [skip] id={$id} missing: {$name}\n";
            continue;
        }

        $key = 'products/' . $name;

        if ($dryRun) {
            echo "  [dry ] id={$id} {$name} -> {$key}\n";
            $migrated++;
            continue;
        }

        try {
            if (isset($urlCache[$name])) {
                $url = $urlCache[$name]; // already uploaded this physical file
            } else {
                $mime = $finfo->file($local) ?: 'application/octet-stream';
                $url = $storage->put($local, $key, $mime);
                $urlCache[$name] = $url;
            }
            $upd->bind_param('si', $url, $id);
            $upd->execute();
            $migrated++;
            echo "  [ok  ] id={$id} -> {$url}\n";
        } catch (Throwable $e) {
            $failed++;
            error_log("migrate_products {$table}#{$id} failed: " . $e->getMessage());
            echo "  [fail] id={$id}: " . $e->getMessage() . "\n";
        }
    }
    echo "  done. migrated={$migrated} missing={$missing} failed={$failed}\n";
}

echo ($dryRun ? "[DRY RUN] " : "") . "Migrating product images to object storage...\n\n";

$urlCache = [];
migrateProductColumn($conn, $storage, $finfo, 'product_images', 'file_path', $dryRun, $limit, $urlCache);
echo "\n";
migrateProductColumn($conn, $storage, $finfo, 'products', 'image_path', $dryRun, $limit, $urlCache);

echo "\nAll done.\n";
</file>

<file path="scripts/migrate_slips_to_r2.php">
<?php
/**
 * Backfill existing local payment/payout slips to Cloud Object Storage (R2/S3).
 *
 * Slips are PRIVATE: we store the object KEY (e.g. "slips/<name>.jpg") in the DB
 * and stream bytes through the authorized SlipController / WithdrawalSlipController.
 * We never expose a public URL.
 *
 * Safe to run repeatedly (idempotent): only touches rows whose stored value is
 * still a bare local filename (no "/" and not an http URL). Missing local files
 * are skipped, never blanked — no data is lost.
 *
 * Usage:
 *   php scripts/migrate_slips_to_r2.php --dry-run
 *   php scripts/migrate_slips_to_r2.php
 *   php scripts/migrate_slips_to_r2.php --limit=1000
 */

if (PHP_SAPI !== 'cli') {
    http_response_code(403);
    exit("This script must be run from the command line.\n");
}

require_once __DIR__ . '/../includes/db.php';
require_once __DIR__ . '/../includes/config.php';
require_once __DIR__ . '/../includes/order_helper.php';
require_once __DIR__ . '/../includes/ObjectStorage.php';

$dryRun = in_array('--dry-run', $argv, true);
$limit = 500;
foreach ($argv as $arg) {
    if (preg_match('/^--limit=(\d+)$/', $arg, $m)) {
        $limit = max(1, (int) $m[1]);
    }
}

$storage = new ObjectStorage();
if (!$storage->isConfigured()) {
    fwrite(STDERR, "Object storage (S3_*) is not configured. Set env vars first.\n");
    exit(1);
}

$finfo = new finfo(FILEINFO_MIME_TYPE);

/**
 * Migrate one table/column of slips. Stores the object key back into the column.
 *
 * @param string $subdir  local uploads subdir AND cloud key prefix (e.g. "slips")
 */
function migrateSlipColumn(
    mysqli $conn,
    ObjectStorage $storage,
    finfo $finfo,
    string $table,
    string $col,
    string $subdir,
    bool $dryRun,
    int $limit
): void {
    // Rows still on local storage: bare filename (no "/"), not an http URL.
    $countRes = $conn->query(
        "SELECT COUNT(*) AS c FROM {$table}
          WHERE {$col} IS NOT NULL AND {$col} <> ''
            AND {$col} NOT LIKE 'http%' AND {$col} NOT LIKE '%/%'"
    );
    $remaining = $countRes ? (int) $countRes->fetch_assoc()['c'] : 0;
    echo "[{$table}.{$col}] on local storage: {$remaining}\n";

    $rows = $conn->query(
        "SELECT id, {$col} AS ref FROM {$table}
          WHERE {$col} IS NOT NULL AND {$col} <> ''
            AND {$col} NOT LIKE 'http%' AND {$col} NOT LIKE '%/%'
          ORDER BY id ASC
          LIMIT " . (int) $limit
    );
    if (!$rows || $rows->num_rows === 0) {
        echo "  nothing to migrate.\n";
        return;
    }

    $localDir = rtrim(flixoUploadsSubdir($subdir), "/\\");
    $upd = $conn->prepare("UPDATE {$table} SET {$col} = ? WHERE id = ?");

    $migrated = 0; $missing = 0; $failed = 0;
    while ($row = $rows->fetch_assoc()) {
        $id   = (int) $row['id'];
        $name = basename((string) $row['ref']);
        $local = $localDir . DIRECTORY_SEPARATOR . $name;

        if (!is_file($local)) {
            $missing++;
            echo "  [skip] id={$id} missing: {$name}\n";
            continue;
        }

        $mime = $finfo->file($local) ?: 'application/octet-stream';
        $key  = $subdir . '/' . $name; // keep the original filename as the key

        if ($dryRun) {
            echo "  [dry ] id={$id} {$name} -> {$key}\n";
            $migrated++;
            continue;
        }

        try {
            $storage->put($local, $key, $mime); // ignore returned URL; store the KEY
            $upd->bind_param('si', $key, $id);
            $upd->execute();
            $migrated++;
            echo "  [ok  ] id={$id} -> {$key}\n";
        } catch (Throwable $e) {
            $failed++;
            error_log("migrate_slips {$table}#{$id} failed: " . $e->getMessage());
            echo "  [fail] id={$id}: " . $e->getMessage() . "\n";
        }
    }
    echo "  done. migrated={$migrated} missing={$missing} failed={$failed}\n";
}

echo ($dryRun ? "[DRY RUN] " : "") . "Migrating slips to object storage...\n\n";

migrateSlipColumn($conn, $storage, $finfo, 'orders', 'slip_image', 'slips', $dryRun, $limit);
echo "\n";
migrateSlipColumn($conn, $storage, $finfo, 'withdrawal_requests', 'payout_slip', 'withdrawal_slips', $dryRun, $limit);

echo "\nAll done.\n";
