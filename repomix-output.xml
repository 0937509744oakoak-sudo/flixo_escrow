                if (data.status === 'success') {
                    msg.style.color = '#1b5e20';
                    msg.textContent = 'บันทึกชื่อเรียบร้อยแล้ว';
                    var heroTitle = document.querySelector('.profile-hero-card h2');
                    if (heroTitle && data.display_name) {
