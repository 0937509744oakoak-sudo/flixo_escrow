<file path="controllers/FollowController.php">
<?php
/**
 * Follow / unfollow a seller (AJAX, JSON).
 */
require_once __DIR__ . '/../includes/init.php';
require_once __DIR__ . '/../models/User.php';

header('Content-Type: application/json; charset=utf-8');

if (empty($_SESSION['user'])) {
    http_response_code(401);
    echo json_encode(['status' => 'error', 'message' => 'กรุณาเข้าสู่ระบบก่อนติดตามผู้ขาย'], JSON_UNESCAPED_UNICODE);
    exit;
}

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    http_response_code(405);
    echo json_encode(['status' => 'error', 'message' => 'Method not allowed'], JSON_UNESCAPED_UNICODE);
    exit;
}

verifyCsrfToken($_POST['csrf_token'] ?? '');

$me = $_SESSION['user'];
$target = sanitizeUsername($_POST['target'] ?? '');

if ($target === '' || $target === $me) {
    http_response_code(400);
    echo json_encode(['status' => 'error', 'message' => 'คำขอไม่ถูกต้อง'], JSON_UNESCAPED_UNICODE);
    exit;
}

$userModel = new User($conn);
$targetUser = $userModel->findByUsername($target);
if (!$targetUser || ($targetUser['status'] ?? '') === 'banned') {
    http_response_code(404);
    echo json_encode(['status' => 'error', 'message' => 'ไม่พบผู้ใช้นี้'], JSON_UNESCAPED_UNICODE);
    exit;
}

if ($userModel->isFollowing($me, $target)) {
    $userModel->unfollow($me, $target);
    $following = false;
} else {
    $userModel->follow($me, $target);
    $following = true;
}

echo json_encode([
    'status' => 'success',
    'following' => $following,
    'follower_count' => $userModel->countFollowers($target),
], JSON_UNESCAPED_UNICODE);
</file>

<file path="controllers/NotificationController.php">
<?php
require_once __DIR__ . '/../includes/init.php';
require_once __DIR__ . '/../includes/NotificationService.php';

if (!isset($_SESSION['user'])) {
    http_response_code(403);
    header('Content-Type: application/json; charset=utf-8');
    echo json_encode(['status' => 'error', 'message' => 'Unauthorized'], JSON_UNESCAPED_UNICODE);
    exit;
}

$me = $_SESSION['user'];
$action = $_POST['action'] ?? $_GET['action'] ?? '';

header('Content-Type: application/json; charset=utf-8');

function formatNotificationTime(string $createdAt): string
{
    $ts = strtotime($createdAt);
    if (!$ts) {
        return '';
    }
    return (date('Ymd') === date('Ymd', $ts)) ? date('H:i', $ts) : date('d/m/Y', $ts);
}

function formatNotificationRow(array $row): array
{
    return [
        'id' => (int) $row['id'],
        'type' => $row['type'] ?? 'system',
        'title' => $row['title'] ?? '',
        'message' => $row['message'] ?? '',
        'url' => $row['link_url'] ?? '',
        'icon' => $row['icon'] ?? '🔔',
        'is_read' => !empty($row['is_read']),
        'time' => formatNotificationTime($row['created_at'] ?? ''),
    ];
}

switch ($action) {
    case 'unread_count':
        echo json_encode([
            'status' => 'success',
            'count' => NotificationService::getUnreadCount($conn, $me),
        ], JSON_UNESCAPED_UNICODE);
        break;

    case 'list':
        $rows = NotificationService::getRecent($conn, $me, 20);
        echo json_encode([
            'status' => 'success',
            'notifications' => array_map('formatNotificationRow', $rows),
        ], JSON_UNESCAPED_UNICODE);
        break;

    case 'latest_unread':
        $row = NotificationService::getLatestUnread($conn, $me);
        if (!$row) {
            echo json_encode(['status' => 'empty'], JSON_UNESCAPED_UNICODE);
            break;
        }
        echo json_encode([
            'status' => 'success',
            'notification' => [
                'title' => $row['title'] !== '' ? $row['title'] : 'FLIXO',
                'body' => $row['message'],
                'url' => $row['link_url'] ?: (rtrim(BASE_URL, '/') . '/dashboard.php'),
                'icon' => $row['icon'] ?: '🔔',
            ],
        ], JSON_UNESCAPED_UNICODE);
        break;

    case 'mark_read':
        verifyCsrfToken($_POST['csrf_token'] ?? '');
        $id = (int) ($_POST['id'] ?? 0);
        $ok = $id > 0 && NotificationService::markRead($conn, $me, $id);
        echo json_encode(['status' => $ok ? 'success' : 'error'], JSON_UNESCAPED_UNICODE);
        break;

    case 'mark_all_read':
        verifyCsrfToken($_POST['csrf_token'] ?? '');
        $ok = NotificationService::markAllRead($conn, $me);
        echo json_encode(['status' => $ok ? 'success' : 'error'], JSON_UNESCAPED_UNICODE);
        break;

    case 'save_push_subscription':
        verifyCsrfToken($_POST['csrf_token'] ?? '');
        $endpoint = trim($_POST['endpoint'] ?? '');
        $p256dh = trim($_POST['p256dh'] ?? '');
        $auth = trim($_POST['auth'] ?? '');
        $userAgent = substr(trim($_SERVER['HTTP_USER_AGENT'] ?? ''), 0, 255);
        $ok = NotificationService::savePushSubscription($conn, $me, $endpoint, $p256dh, $auth, $userAgent);
        echo json_encode(['status' => $ok ? 'success' : 'error'], JSON_UNESCAPED_UNICODE);
        break;

    case 'remove_push_subscription':
        verifyCsrfToken($_POST['csrf_token'] ?? '');
        $endpoint = trim($_POST['endpoint'] ?? '');
        $ok = NotificationService::removePushSubscription($conn, $me, $endpoint);
        echo json_encode(['status' => $ok ? 'success' : 'error'], JSON_UNESCAPED_UNICODE);
        break;

    case 'get_preferences':
        $prefs = NotificationService::getPreferences($conn, $me);
        echo json_encode([
            'status' => 'success',
            'preferences' => $prefs,
            'vapid_public_key' => defined('VAPID_PUBLIC_KEY') ? VAPID_PUBLIC_KEY : '',
            'push_configured' => WebPush::isConfigured(),
        ], JSON_UNESCAPED_UNICODE);
        break;

    case 'update_preferences':
        verifyCsrfToken($_POST['csrf_token'] ?? '');
        $emailEnabled = !empty($_POST['email_enabled']);
        $pushEnabled = !empty($_POST['push_enabled']);
        $marketingEnabled = !empty($_POST['marketing_enabled']);
        $ok = NotificationService::updatePreferences($conn, $me, $emailEnabled, $pushEnabled, $marketingEnabled);
        echo json_encode(['status' => $ok ? 'success' : 'error'], JSON_UNESCAPED_UNICODE);
        break;

    default:
        http_response_code(400);
        echo json_encode(['status' => 'error', 'message' => 'Unknown action'], JSON_UNESCAPED_UNICODE);
}
</file>

<file path="controllers/ProductImageController.php">
<?php
/**
 * Serve product images from uploads volume (public).
 * Works even when Apache cannot see a Railway Volume path correctly.
 */
require_once __DIR__ . '/../includes/config.php';

$raw = (string) ($_GET['f'] ?? '');
$filename = basename(str_replace(['\\', "\0"], '', $raw));

if ($filename === '' || preg_match('/[^a-zA-Z0-9._-]/', $filename)) {
    http_response_code(400);
    exit('Invalid file');
}

$uploadsRoot = null;
foreach (['UPLOADS_PATH', 'RAILWAY_VOLUME_MOUNT_PATH'] as $envKey) {
    $val = getenv($envKey);
    if (is_string($val) && trim($val) !== '') {
        $candidate = rtrim(trim($val), "/\\");
        if (is_dir($candidate)) {
            $uploadsRoot = $candidate;
            break;
        }
    }
}
if ($uploadsRoot === null) {
    $uploadsRoot = dirname(__DIR__) . DIRECTORY_SEPARATOR . 'uploads';
}

$candidates = [
    $uploadsRoot . DIRECTORY_SEPARATOR . 'products' . DIRECTORY_SEPARATOR . $filename,
    dirname(__DIR__) . DIRECTORY_SEPARATOR . 'uploads' . DIRECTORY_SEPARATOR . 'products' . DIRECTORY_SEPARATOR . $filename,
];

$filepath = null;
foreach (array_unique($candidates) as $path) {
    if (is_file($path)) {
        $filepath = $path;
        break;
    }
}

if ($filepath === null) {
    $placeholder = dirname(__DIR__) . DIRECTORY_SEPARATOR . 'assets' . DIRECTORY_SEPARATOR . 'images' . DIRECTORY_SEPARATOR . 'product-placeholder.svg';
    if (is_file($placeholder)) {
        header('Content-Type: image/svg+xml');
        header('Cache-Control: public, max-age=300');
        readfile($placeholder);
        exit;
    }
    http_response_code(404);
    exit('Not found');
}

$ext = strtolower(pathinfo($filepath, PATHINFO_EXTENSION));
$mime = match ($ext) {
    'jpg', 'jpeg' => 'image/jpeg',
    'png' => 'image/png',
    'webp' => 'image/webp',
    'gif' => 'image/gif',
    'svg' => 'image/svg+xml',
    default => 'application/octet-stream',
};

header('Content-Type: ' . $mime);
header('Content-Length: ' . (string) filesize($filepath));
header('Cache-Control: public, max-age=86400');
header('X-Content-Type-Options: nosniff');
readfile($filepath);
exit;
</file>

<file path="controllers/UserController.php">
<?php
// controllers/UserController.php
require_once __DIR__ . '/../includes/init.php';
ini_set('display_errors', 0);
ini_set('log_errors', 1);
require_once __DIR__ . '/../includes/order_helper.php';
require_once __DIR__ . '/../includes/legal.php';
require_once __DIR__ . '/../includes/PiiEncryption.php';
require_once __DIR__ . '/../models/User.php';
require_once __DIR__ . '/../models/Consent.php';
verifyCsrfToken($_POST['csrf_token'] ?? '');

header('Content-Type: application/json');

try {
    if (!isset($_SESSION['user'])) {
        throw new Exception('กรุณาเข้าสู่ระบบ', 403);
    }

    $action = $_POST['action'] ?? '';
    $me = $_SESSION['user'];
    
    // เรียกใช้ Model
    $userModel = new User($conn);

    if ($action == 'submit_kyc') {
        if (empty($_POST['consent_kyc'])) {
            throw new Exception('กรุณายินยอมให้จัดเก็บและประมวลผลข้อมูล KYC');
        }
        if (!isset($_FILES['id_card'])) {
            throw new Exception('ไม่พบไฟล์บัตรประชาชน');
        }
        if (!isset($_FILES['selfie'])) {
            throw new Exception('กรุณาถ่ายรูปใบหน้า (Selfie) เพื่อยืนยันตัวตน');
        }

        $userId = (int)($_SESSION['user_id'] ?? 0);
        if ($userId <= 0) {
            $userRow = $userModel->findByUsername($me);
            $userId = (int)($userRow['id'] ?? 0);
        }

        $id_name = secureUpload($_FILES['id_card'], __DIR__ . '/../uploads/kyc/');
        $id_path = realpath(__DIR__ . '/../uploads/kyc/' . $id_name);
        if ($id_path) {
            $id_name = PiiEncryption::encryptFile($id_path);
        }

        $selfie_name = secureUpload($_FILES['selfie'], __DIR__ . '/../uploads/kyc/');
        $selfie_path = realpath(__DIR__ . '/../uploads/kyc/' . $selfie_name);
        if ($selfie_path) {
            $selfie_name = PiiEncryption::encryptFile($selfie_path);
        }

        if ($userModel->updateKyc($me, $id_name, $selfie_name)) {
            if ($userId > 0) {
                $consentModel = new Consent($conn);
                $consentModel->record($userId, 'kyc_data_collection', KYC_CONSENT_VERSION);
            }
            echo json_encode(['status' => 'success'], JSON_UNESCAPED_UNICODE);
        } else {
            throw new Exception('Database Update Failed');
        }
    } elseif ($action === 'update_display_name') {
        $realName = trim($_POST['real_name'] ?? '');
        if ($realName === '') {
            throw new Exception('กรุณาระบุชื่อ-นามสกุล');
        }
        if (mb_strlen($realName) > 100) {
            throw new Exception('ชื่อ-นามสกุลยาวเกินไป');
        }

        $userId = (int) ($_SESSION['user_id'] ?? 0);
        if ($userId <= 0) {
            $userRow = $userModel->findByUsername($me);
            $userId = (int) ($userRow['id'] ?? 0);
        }
        if ($userId <= 0) {
            throw new Exception('ไม่พบบัญชีผู้ใช้');
        }

        if (!$userModel->updateRealName($userId, $realName)) {
            throw new Exception('ไม่สามารถบันทึกชื่อได้');
        }

        echo json_encode([
            'status' => 'success',
            'display_name' => $realName,
        ], JSON_UNESCAPED_UNICODE);
    } else {
        throw new Exception('คำสั่งไม่ถูกต้อง');
    }

} catch (Exception $e) {
    error_log("Controller Error [UserController]: " . $e->getMessage());
    echo json_encode(['status' => 'error', 'message' => $e->getMessage()]);
}
?>
</file>

<file path="controllers/WalletController.php">
<?php
// controllers/WalletController.php
require_once __DIR__ . '/../includes/init.php';
require_once __DIR__ . '/../includes/WalletService.php';
require_once __DIR__ . '/../models/Wallet.php';
verifyCsrfToken($_POST['csrf_token'] ?? '');

header('Content-Type: application/json; charset=utf-8');

try {
    if (!isset($_SESSION['user'])) {
        throw new Exception('กรุณาเข้าสู่ระบบ', 403);
    }

    $me = $_SESSION['user'];
    $userId = (int)($_SESSION['user_id'] ?? 0);
    if ($userId <= 0) {
        $w = new Wallet($conn);
        $userId = (int)($w->getUserIdByUsername($me) ?? 0);
    }

    $action = $_POST['action'] ?? '';
    $walletModel = new Wallet($conn);
    $walletService = new WalletService($conn);

    if ($action === 'save_bank') {
        $bankCode = trim($_POST['bank_code'] ?? '');
        $bankName = trim($_POST['bank_name'] ?? '');
        $accountNumber = preg_replace('/[^0-9]/', '', $_POST['account_number'] ?? '');
        $accountName = trim($_POST['account_name'] ?? '');

        if ($bankCode === '' || $bankName === '' || strlen($accountNumber) < 10 || $accountName === '') {
            throw new Exception('กรุณากรอกข้อมูลบัญชีธนาคารให้ครบถ้วน');
        }

        $stmt = $conn->prepare('SELECT real_name, is_verified FROM users WHERE id = ?');
        $stmt->bind_param('i', $userId);
        $stmt->execute();
        $userRow = $stmt->get_result()->fetch_assoc();
        $kycName = trim((string)($userRow['real_name'] ?? ''));
        if (!empty($userRow['is_verified'])) {
            if ($kycName === '') {
                throw new Exception('ไม่พบชื่อจากการยืนยันตัวตน — ติดต่อฝ่ายสนับสนุน');
            }
            if (!bankAccountNameMatchesKyc($accountName, $kycName)) {
                throw new Exception('ชื่อบัญชีต้องตรงกับชื่อที่ยืนยันตัวตน (KYC): ' . $kycName);
            }
        }

        $id = $walletModel->saveBankAccount($userId, $bankCode, $bankName, $accountNumber, $accountName, true);
        echo json_encode(['status' => 'success', 'bank_account_id' => $id], JSON_UNESCAPED_UNICODE);
        exit;
    }

    if ($action === 'withdraw') {
        $amount = (float)($_POST['amount'] ?? 0);
        $bankAccountId = (int)($_POST['bank_account_id'] ?? 0);

        $stmt = $conn->prepare("SELECT is_verified FROM users WHERE id = ?");
        $stmt->bind_param('i', $userId);
        $stmt->execute();
        $u = $stmt->get_result()->fetch_assoc();
        if (empty($u['is_verified'])) {
            throw new Exception('กรุณายืนยันตัวตน (KYC) ก่อนถอนเงิน');
        }

        $result = $walletService->requestWithdrawal($me, $amount, $bankAccountId);
        if (!$result['ok']) {
            throw new Exception($result['error'] ?? 'ไม่สามารถสร้างคำขอถอนได้');
        }
        echo json_encode(['status' => 'success', 'request_id' => $result['request_id'], 'message' => 'ส่งคำขอถอนเงินแล้ว รอแอดมินอนุมัติ'], JSON_UNESCAPED_UNICODE);
        exit;
    }

    throw new Exception('Invalid action');
} catch (Exception $e) {
    echo json_encode(['status' => 'error', 'message' => $e->getMessage()], JSON_UNESCAPED_UNICODE);
}
