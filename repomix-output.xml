}

/* App views / transitions */
#app-views {
    position: relative;
    min-height: 200px;
    overflow: hidden;
}

#app-views.is-transitioning > .app-view.is-shown {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    pointer-events: none;
}

#app-views.is-transitioning > .app-view.is-shown.is-active {
    z-index: 2;
}

#app-views.is-transitioning > .app-view.is-shown:not(.is-active) {
    z-index: 1;
}

.app-view {
    display: none;
    opacity: 0;
    transform: translateY(16px);
    transition:
        opacity 0.3s ease,
        transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity;
}

.app-view.is-shown {
    display: block;
}

.app-view.is-active {
    opacity: 1;
    transform: translate(0, 0);
}

/* Fade + slide up (main pages) */
.app-view.is-enter-fade-up {
    opacity: 0;
    transform: translateY(16px);
}

.app-view.is-fade-out {
    opacity: 0;
    transform: translateY(0);
}

/* Horizontal slide (main tabs + sub-tabs) */
.app-view.is-exit-slide-left {
    opacity: 0.85;
    transform: translateX(-100%);
}

.app-view.is-exit-slide-right {
    opacity: 0.85;
    transform: translateX(100%);
}

.app-view.is-enter-slide-right {
    opacity: 0.85;
    transform: translateX(100%);
}

.app-view.is-enter-slide-left {
    opacity: 0.85;
    transform: translateX(-100%);
}

@media (prefers-reduced-motion: reduce) {
    .app-view {
        transition: none;
    }
}

/* Tactile press — scale down on click */
.home-quick-btn,
.nav-tab-btn,
.mobile-nav-btn,
.hero-search-btn-finance,
.btn-flixo-primary,
.btn-flixo-outline,
.home-alert-link,
.catalog-empty-cta,
.chat-action-btn,
.chat-send-btn,
.chat-back-btn,
.chat-compose-icon-btn,
.chat-inbox-cta,
.nav-icon-btn,
.nav-profile-btn {
    -webkit-tap-highlight-color: transparent;
}

.home-quick-btn:active {
    transform: scale(0.98);
    box-shadow: var(--flixo-shadow);
}

.nav-tab-btn:active,
.mobile-nav-btn:active,
.hero-search-btn-finance:active,
.home-alert-link:active,
