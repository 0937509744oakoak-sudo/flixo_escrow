/* FLIXO Notifications — bell badge + dropdown (self-contained, works on every page) */

.notif-bell-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
}

.notif-bell-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
    transition: background 0.15s ease;
}

.notif-bell-btn:hover {
    background: rgba(0, 80, 203, 0.08);
}

.notif-bell-icon {
    display: inline-block;
}

.notif-bell-badge {
    position: absolute;
    top: 0;
    right: 0;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    background: #ba1a1a;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    font-family: Arial, sans-serif;
    line-height: 16px;
    text-align: center;
    border-radius: 999px;
    display: none;
    align-items: center;
    justify-content: center;
}

.notif-dropdown {
