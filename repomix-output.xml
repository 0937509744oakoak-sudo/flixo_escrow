/** "ออนไลน์" = ใช้งานภายใน 5 นาทีล่าสุด */
function flixoIsOnline(?string $lastActiveAt): bool {
    if (!$lastActiveAt) {
        return false;
    }
    return (time() - strtotime($lastActiveAt)) <= 300;
}

/** เวลาแบบอ่านง่ายภาษาไทย เช่น "5 นาทีที่แล้ว" */
function flixoTimeAgo(?string $datetime): string {
    if (!$datetime) {
        return '';
    }
    $diff = time() - strtotime($datetime);
    if ($diff < 60) {
        return 'เมื่อสักครู่';
    }
    if ($diff < 3600) {
        return floor($diff / 60) . ' นาทีที่แล้ว';
    }
    if ($diff < 86400) {
        return floor($diff / 3600) . ' ชั่วโมงที่แล้ว';
    }
    if ($diff < 86400 * 30) {
        return floor($diff / 86400) . ' วันที่แล้ว';
    }
    if ($diff < 86400 * 365) {
        return floor($diff / (86400 * 30)) . ' เดือนที่แล้ว';
    }
    return floor($diff / (86400 * 365)) . ' ปีที่แล้ว';
}

function userDisplayName(mysqli $conn, string $username): string {
    static $cache = [];
    if (isset($cache[$username])) {
        return $cache[$username];
    }
    require_once __DIR__ . '/../models/User.php';
    $cache[$username] = (new User($conn))->getDisplayName($username);
    return $cache[$username];
}

function sanitizeUsername($username) {
    $username = trim((string)$username);
    $username = preg_replace('/[^A-Za-z0-9_.-]/u', '', $username);
    return mb_substr($username, 0, 32);
}

function sanitizePhone($phone) {
    return preg_replace('/[^0-9]/', '', (string)$phone);
}

function validateDate($date) {
    $d = DateTime::createFromFormat('Y-m-d', $date);
    return $d && $d->format('Y-m-d') === $date;
}

/** Normalize Thai/Latin person names for comparison (KYC vs bank account). */
function normalizePersonName(string $name): string {
    $name = trim(preg_replace('/\s+/u', ' ', $name));
    return mb_strtolower($name, 'UTF-8');
}

function bankAccountNameMatchesKyc(string $accountName, string $kycName): bool {
    $accountName = normalizePersonName($accountName);
    $kycName = normalizePersonName($kycName);
    if ($accountName === '' || $kycName === '') {
        return false;
    }
    return $accountName === $kycName;
}

function clearSession() {
    if (session_status() !== PHP_SESSION_ACTIVE) {
        session_start();
    }
    $_SESSION = [];
    if (ini_get('session.use_cookies')) {
        $params = session_get_cookie_params();
        setcookie(session_name(), '', time() - 42000, $params['path'], $params['domain'], $params['secure'], $params['httponly']);
    }
    session_destroy();
}

