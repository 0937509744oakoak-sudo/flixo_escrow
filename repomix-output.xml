    color: #f8fafc;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    margin-right: 8px;
}

.nav-admin-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.3);
    color: #fff;
}

.nav-admin-btn__icon {
    font-size: 16px;
    line-height: 1;
}

.nav-admin-btn__badge {
    background: #f59e0b;
    color: #1e293b;
    font-size: 10px;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 6px;
    letter-spacing: 0.03em;
}

@media (max-width: 768px) {
    .staff-admin-portal__inner {
        flex-direction: column;
        align-items: stretch;
        text-align: center;
        padding: 20px;
    }

    .staff-admin-portal__btn {
        justify-content: center;
        width: 100%;
    }

    .nav-admin-btn__text {
        display: none;
    }

    .nav-admin-btn {
        padding: 8px 10px;
    }
}

/* Product catalog — Shopee-style grid */
.product-catalog-section {
    margin-bottom: 8px;
}

.catalog-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
}

.catalog-title {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 4px;
    color: var(--flixo-on-surface);
}

[data-theme="dark"] .catalog-title {
    color: var(--flixo-inverse-on);
}

.catalog-subtitle {
    font-size: 13px;
    color: var(--flixo-on-surface-variant);
    margin: 0;
}

.catalog-sell-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 10px 18px;
    flex-shrink: 0;
    text-decoration: none;
    font-size: 13px;
}

.catalog-sell-btn .material-symbols-outlined {
    font-size: 18px;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

@media (min-width: 640px) {
    .product-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }
}

@media (min-width: 1024px) {
    .product-grid {
        grid-template-columns: repeat(4, 1fr);
    }
}

@media (min-width: 1280px) {
    .product-grid {
        grid-template-columns: repeat(5, 1fr);
    }
}

.product-card {
    background: #fff;
    border: 1px solid rgba(194, 198, 216, 0.35);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
}

[data-theme="dark"] .product-card {
    background: var(--flixo-inverse);
    border-color: rgba(194, 198, 216, 0.12);
}

.product-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
}

.product-card-img {
    aspect-ratio: 1;
    overflow: hidden;
    background: #f3f4f8;
}

.product-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.product-card:hover .product-card-img img {
    transform: scale(1.05);
}

.product-card-body {
    padding: 10px 12px 12px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.product-card-name {
    font-size: 13px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--flixo-on-surface);
    min-height: 2.8em;
}

[data-theme="dark"] .product-card-name {
    color: var(--flixo-inverse-on);
}

.product-card-price {
    font-size: 16px;
    font-weight: 700;
    color: var(--flixo-primary);
    margin-top: 2px;
}

.product-card-seller {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    font-size: 11px;
    color: var(--flixo-on-surface-variant);
}

.product-card-seller-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.product-card-verified {
    color: #28a745;
    font-weight: 700;
    font-size: 12px;
    flex-shrink: 0;
}

.product-card-rating {
    flex-shrink: 0;
}

.product-card-badge {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-size: 10px;
    font-weight: 600;
    color: var(--flixo-tertiary);
    margin-top: auto;
    padding-top: 4px;
}

.product-card-badge .material-symbols-outlined {
    font-size: 13px;
}

.catalog-empty {
    background: #fff;
    border-radius: 16px;
    border: 1px solid rgba(194, 198, 216, 0.35);
}

[data-theme="dark"] .catalog-empty {
    background: var(--flixo-inverse);
}

/* Catalog pagination */
.catalog-pagination {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid rgba(194, 198, 216, 0.35);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
}

.catalog-pagination-meta {
    margin: 0;
    text-align: center;
}

.catalog-pagination-controls {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
}

.catalog-page-btn,
.catalog-page-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 10px;
    border-radius: 10px;
    border: 1px solid rgba(194, 198, 216, 0.5);
    background: #fff;
    color: var(--flixo-on-surface);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: background 0.15s ease, border-color 0.15s ease;
}

[data-theme="dark"] .catalog-page-btn,
[data-theme="dark"] .catalog-page-num {
    background: var(--flixo-inverse);
    border-color: rgba(194, 198, 216, 0.15);
    color: var(--flixo-inverse-on);
}

.catalog-page-btn:hover,
.catalog-page-num:hover {
    border-color: var(--flixo-primary);
    color: var(--flixo-primary);
}

.catalog-page-num.is-active {
    background: var(--flixo-primary);
    border-color: var(--flixo-primary);
    color: #fff;
}

.catalog-page-btn.is-disabled {
    opacity: 0.35;
    pointer-events: none;
}

.catalog-page-btn .material-symbols-outlined {
    font-size: 20px;
}

/* Review list */
.review-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 12px;
}

.review-item {
    padding: 14px 0;
    border-bottom: 1px solid rgba(194, 198, 216, 0.35);
}

.review-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.review-item-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
}

.review-item-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
    flex-shrink: 0;
}

.review-item-meta {
    flex: 1;
    min-width: 0;
}

.review-item-name {
    display: block;
    font-size: 14px;
}

.review-item-date {
    font-size: 12px;
}

.review-item-stars {
    color: #f59e0b;
    font-size: 13px;
    letter-spacing: 1px;
    flex-shrink: 0;
}

.review-item-comment {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--flixo-on-surface-variant);
}

.review-list-empty {
    margin: 12px 0 0;
}

.product-reviews-section {
    margin-top: 28px;
}

.product-reviews-more {
    margin: 8px 0 0;
    text-align: center;
}

.order-deal-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 10px;
    flex-wrap: wrap;
}

.order-review-cta {
    font-size: 13px;
    font-weight: 600;
    color: #f39c12;
    text-decoration: none;
}

.order-review-cta:hover {
    text-decoration: underline;
}

.order-reviewed-badge {
    font-size: 12px;
}

/* Orders tab — simplified */
.orders-tab-card {
    padding-bottom: 8px;
    max-width: 880px;
    margin-left: auto;
    margin-right: auto;
}

.orders-tab-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
}

.orders-tab-header h3 {
    margin: 0;
}

.orders-action-badge {
    flex-shrink: 0;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    background: rgba(186, 26, 26, 0.1);
    color: #ba1a1a;
}

.orders-filter-bar {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
}

.orders-filter-chip {
    border: 1px solid rgba(194, 198, 216, 0.6);
    background: #fff;
    color: var(--flixo-on-surface-variant);
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
}

.orders-filter-chip:hover {
    border-color: var(--flixo-primary);
    color: var(--flixo-primary);
}

.orders-filter-chip.active {
    background: rgba(0, 80, 203, 0.08);
    border-color: var(--flixo-primary);
    color: var(--flixo-primary);
}

.order-tab-item {
    padding: 14px 16px;
    border-radius: var(--flixo-radius);
    background: var(--flixo-muted-bg);
    border: 1px solid var(--flixo-hairline);
    margin-bottom: 10px;
}

.order-tab-item.is-action {
    background: #fff;
    border-color: rgba(0, 80, 203, 0.25);
    box-shadow: 0 2px 12px rgba(0, 80, 203, 0.06);
}

.order-tab-item-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
}

.order-tab-role {
    font-size: 11px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
}

.order-tab-role--buy {
    background: rgba(0, 80, 203, 0.1);
    color: var(--flixo-primary);
}

.order-tab-role--sell {
    background: rgba(0, 100, 69, 0.1);
    color: var(--flixo-tertiary);
}

.order-tab-item-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
}

.order-tab-title {
    font-weight: 700;
    font-size: 15px;
    line-height: 1.35;
    margin-bottom: 4px;
}

.order-tab-meta {
    font-size: 12px;
    color: var(--flixo-on-surface-variant);
}

.order-tab-hint {
    font-size: 12px;
    color: var(--flixo-primary);
    margin-top: 6px;
    font-weight: 500;
}

.order-tab-amount {
    font-family: 'Hanken Grotesk', sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: var(--flixo-primary);
    white-space: nowrap;
}

.order-tab-actions {
    margin-top: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.order-tab-btn {
    padding: 8px 16px !important;
    font-size: 13px !important;
    min-height: auto !important;
}

.order-tab-btn-dispute {
    color: #dc2626 !important;
    border-color: #fecaca !important;
}

.order-tab-btn-dispute:hover {
    background: #fef2f2 !important;
    border-color: #f87171 !important;
}

.order-tab-chat {
    display: inline-flex !important;
    align-items: center;
    gap: 4px;
    text-decoration: none;
}

.order-tab-chat .material-symbols-outlined {
    font-size: 16px;
}

.order-tab-wait,
.order-tab-done {
    font-size: 12px;
}

.orders-empty-cta {
    display: inline-block;
    margin-top: 12px;
    padding: 10px 18px;
    font-size: 14px;
    text-decoration: none;
}

.pill-muted {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.06);
    color: #666;
}

.pill-warning {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    background: rgba(186, 26, 26, 0.1);
    color: #ba1a1a;
}

.pill-alert {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 700;
    background: rgba(243, 156, 18, 0.15);
    color: #c27803;
}

[data-theme="dark"] .orders-filter-chip {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.12);
}

[data-theme="dark"] .order-tab-item {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.08);
}

[data-theme="dark"] .order-tab-item.is-action {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(179, 197, 255, 0.25);
}

/* Product detail page */
.product-detail-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 24px;
    padding-bottom: 80px;
}

.product-back-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--flixo-primary);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 20px;
}

.product-detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
}

@media (min-width: 768px) {
    .product-detail-grid {
        grid-template-columns: 1fr 1fr;
        gap: 32px;
    }
}

.product-detail-gallery-wrap {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.product-detail-gallery {
    background: var(--flixo-muted-bg);
    border-radius: var(--flixo-radius);
    overflow: hidden;
    aspect-ratio: 1;
}

.product-thumb-strip {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 4px;
}

.product-thumb-btn {
    flex: 0 0 72px;
    width: 72px;
    height: 72px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    background: #f3f4f8;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.product-thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.product-thumb-btn.is-active {
    border-color: var(--flixo-primary);
    box-shadow: 0 0 0 2px rgba(0, 80, 203, 0.2);
}

.product-gallery-meta {
    font-size: 12px;
    color: var(--flixo-on-surface-variant);
    margin: 0;
}

.product-category-chip {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--flixo-primary);
    background: #eff4ff;
    border: 1px solid #dae1ff;
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 10px;
}

.product-detail-gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.product-detail-info h1 {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 1.5rem;
    margin: 0 0 12px;
    line-height: 1.3;
}

.product-detail-price {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--flixo-primary);
    margin-bottom: 20px;
}

.product-detail-seller {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    background: var(--flixo-muted-bg);
    border-radius: var(--flixo-radius);
    margin-bottom: 20px;
}

.product-seller-card {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    background: var(--flixo-card-bg);
    border: 1px solid var(--flixo-hairline);
}

.product-seller-head {
    display: flex;
    align-items: center;
    gap: 12px;
}

.product-seller-avatar-link {
    position: relative;
    display: inline-flex;
    text-decoration: none;
    flex-shrink: 0;
}

.product-seller-online-dot {
    position: absolute;
    right: -1px;
    bottom: -1px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #22c55e;
    border: 2px solid #fff;
}

.product-seller-name-link {
    color: inherit;
    text-decoration: none;
}

.product-seller-name-link:hover {
    color: var(--flixo-primary);
    text-decoration: underline;
}

.product-seller-presence {
    margin-top: 2px;
    font-size: 12px;
    color: var(--flixo-on-surface-variant);
}

.seller-presence-online {
    color: #16a34a;
    font-weight: 600;
}

.product-seller-identity {
    min-width: 0;
}

.product-seller-verified {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-left: 6px;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(0, 102, 69, 0.1);
    color: #006645;
    font-size: 11px;
    font-weight: 700;
    vertical-align: middle;
}

.product-seller-verified .material-symbols-outlined {
    font-size: 14px;
    font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24;
}

.product-seller-stars {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    font-size: 13px;
}

.product-seller-stars-icons {
    color: #f5a623;
    letter-spacing: 1px;
}

.product-seller-stars-meta,
.product-seller-stars-empty {
    color: var(--flixo-on-surface-variant);
    font-size: 12px;
}

.product-seller-chat-btn {
    margin-left: auto;
    padding: 8px 14px;
    flex: 0 0 auto;
    white-space: nowrap;
    align-self: center;
}

.product-seller-stats {
    list-style: none;
    margin: 0;
    padding: 12px 0 0;
    border-top: 1px solid rgba(194, 198, 216, 0.4);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
}

.product-seller-stats li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2px;
}

.product-seller-stat-value {
    font-weight: 700;
    font-size: 15px;
    color: var(--flixo-on-surface);
}

.product-seller-stat-label {
    font-size: 11px;
    color: var(--flixo-on-surface-variant);
}

.product-seller-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--flixo-primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    flex-shrink: 0;
}

.product-seller-name {
    font-weight: 600;
    font-size: 14px;
}

.product-seller-rating {
    font-size: 12px;
    color: var(--flixo-on-surface-variant);
}

.product-detail-desc {
    margin-bottom: 20px;
}

.product-detail-desc h3 {
    font-size: 14px;
    margin: 0 0 8px;
}

.product-detail-desc p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--flixo-on-surface-variant);
    margin: 0;
}

.product-escrow-badge {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 14px;
    background: rgba(0, 102, 69, 0.08);
    border-radius: 12px;
    margin-bottom: 20px;
    border: 1px solid rgba(0, 102, 69, 0.15);
}

.product-escrow-badge .material-symbols-outlined {
    color: var(--flixo-tertiary);
    font-size: 24px;
}

.product-escrow-badge strong {
    display: block;
    font-size: 13px;
    margin-bottom: 2px;
}

.product-escrow-badge p {
    font-size: 12px;
    color: var(--flixo-on-surface-variant);
    margin: 0;
}

.product-buy-btn {
    width: 100%;
    padding: 14px;
    font-size: 16px;
    border: none;
    cursor: pointer;
}

.product-buy-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.nav-tab-link {
    text-decoration: none;
    color: inherit;
}

/* Forms */
.flixo-form {
    display: flex;
    flex-direction: column;
    gap: 16px; /* Spacing between form groups */
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 8px; /* Spacing between label and input */
}

.form-group label {
    font-size: 14px;
    font-weight: 600;
    color: var(--flixo-on-surface-variant);
}

.flixo-form input[type="text"],
.flixo-form input[type="number"],
.flixo-form input[type="file"],
.flixo-form textarea {
    border: 1px solid var(--flixo-outline);
    border-radius: 8px; /* Smaller radius for inputs */
    padding: 10px 14px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: var(--flixo-on-surface);
