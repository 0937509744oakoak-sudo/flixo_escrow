    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
}

.admin-table tr:last-child td {
    border-bottom: none;
}

.admin-table tr:hover td {
    background: #f8fafc;
}

.admin-table .money {
    font-weight: 600;
    color: var(--admin-success);
}

.admin-table .empty {
    text-align: center;
    padding: 32px 16px;
    color: var(--admin-muted);
}

/* Badge */
.admin-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
}

/* Status breakdown */
.admin-status-list {
    padding: 12px 20px 20px;
}

.admin-status-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
}

.admin-status-label {
    width: 130px;
    font-size: 12px;
    color: var(--admin-muted);
    flex-shrink: 0;
}

.admin-status-bar-wrap {
    flex: 1;
    height: 8px;
    background: #e2e8f0;
    border-radius: 4px;
    overflow: hidden;
}

.admin-status-bar {
    height: 100%;
    border-radius: 4px;
    transition: width 0.3s;
}

.admin-status-count {
    width: 40px;
    text-align: right;
    font-size: 13px;
    font-weight: 600;
}

/* Responsive */
@media (max-width: 1024px) {
    .admin-panel-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    .admin-wrapper {
        flex-direction: column;
    }

    .admin-sidebar {
        width: 100%;
        height: auto;
        position: static;
    }

    .admin-content {
        padding: 20px 16px;
    }

    .admin-kpi-value {
        font-size: 22px;
    }
}

/* ── Shared page components ── */

.admin-btn {
    display: inline-block;
    padding: 6px 14px;
    border: none;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    text-decoration: none;
    color: #fff;
    line-height: 1.4;
    transition: opacity 0.15s;
}

.admin-btn:hover { opacity: 0.88; }

.admin-btn-success { background: var(--admin-success); }
.admin-btn-danger  { background: var(--admin-danger); }
.admin-btn-warning { background: var(--admin-warning); }
.admin-btn-info    { background: var(--admin-info); }
.admin-btn-muted   { background: #64748b; }
.admin-btn-primary { background: var(--admin-primary); }

.admin-btn-sm { padding: 4px 10px; font-size: 11px; }

.admin-action-group {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
}

.admin-action-group form { display: inline; margin: 0; }

.admin-text-success { color: var(--admin-success); font-weight: 600; }
.admin-text-danger  { color: var(--admin-danger); font-weight: 600; }
.admin-text-muted   { color: var(--admin-muted); font-size: 12px; }
.admin-text-money   { color: var(--admin-success); font-weight: 600; }

.admin-badge-pending { background: #fef3c7; color: #92400e; }
.admin-badge-done    { background: #dcfce7; color: #166534; }
.admin-badge-flagged { background: #fef3c7; color: #92400e; }
.admin-badge-rejected { background: #fee2e2; color: #991b1b; }

.admin-filter-bar {
    background: var(--admin-card);
    border: 1px solid var(--admin-border);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 24px;
}

.admin-filter-form {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: flex-end;
}

.admin-form-group {
    flex: 1;
    min-width: 180px;
}

.admin-form-group label {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--admin-muted);
    margin-bottom: 6px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
}

.admin-form-group input,
.admin-form-group select,
.admin-form-group textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--admin-border);
    border-radius: 8px;
    font-family: inherit;
    font-size: 14px;
    background: #fff;
    color: var(--admin-text);
}

.admin-form-group input:focus,
.admin-form-group select:focus,
.admin-form-group textarea:focus {
    outline: none;
    border-color: var(--admin-primary);
    box-shadow: 0 0 0 3px rgba(0, 80, 203, 0.1);
}

.admin-section {
    margin-bottom: 28px;
}

.admin-section-title {
    font-size: 15px;
    font-weight: 600;
    margin: 0 0 12px;
}

.admin-slip-thumb {
    height: 56px;
    border: 1px solid var(--admin-border);
    border-radius: 8px;
    transition: transform 0.2s;
    cursor: zoom-in;
}

.admin-slip-thumb:hover {
    transform: scale(2.5);
    position: relative;
    z-index: 10;
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
}

.admin-thumb {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--admin-border);
}

.admin-product-cell {
    display: flex;
    gap: 12px;
    align-items: center;
}

.admin-reasons {
    margin: 4px 0 0;
    padding-left: 18px;
    color: var(--admin-muted);
    font-size: 12px;
}

.sla-overdue { color: var(--admin-danger); font-weight: 700; }

.admin-alert-success {
    background: #dcfce7;
    color: #166534;
    padding: 12px 20px;
    border-radius: 8px;
    margin-bottom: 16px;
    font-size: 14px;
}

/* Support inbox */
.admin-support-wrap {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 56px);
    min-height: 500px;
}

.admin-inbox-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    flex: 1;
    min-height: 0;
    background: var(--admin-card);
    border: 1px solid var(--admin-border);
    border-radius: 12px;
    overflow: hidden;
}

.admin-user-list {
    border-right: 1px solid var(--admin-border);
    overflow-y: auto;
    background: #f8fafc;
}

.admin-user-list a {
    display: block;
    padding: 14px 18px;
    text-decoration: none;
    color: var(--admin-text);
    border-bottom: 1px solid var(--admin-border);
    font-size: 14px;
    transition: background 0.15s;
}

.admin-user-list a:hover,
.admin-user-list a.active {
    background: #eff6ff;
    color: var(--admin-primary);
    font-weight: 500;
}

.admin-chat-panel {
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: #f8fafc;
}

.admin-chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 20px 24px;
}

.admin-msg {
    max-width: 75%;
    margin-bottom: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    font-size: 14px;
    line-height: 1.5;
    white-space: pre-wrap;
}

.admin-msg.support {
    background: var(--admin-primary);
    color: #fff;
    margin-left: auto;
    border-bottom-right-radius: 4px;
}

.admin-msg.user {
    background: #fff;
    border: 1px solid var(--admin-border);
    margin-right: auto;
    border-bottom-left-radius: 4px;
}

.admin-msg time {
    display: block;
    font-size: 11px;
    opacity: 0.7;
    margin-top: 6px;
}

.admin-reply-box {
    background: #fff;
    border-top: 1px solid var(--admin-border);
    padding: 16px 24px;
}

.admin-reply-box textarea {
    width: 100%;
    min-height: 80px;
    border: 1px solid var(--admin-border);
    border-radius: 10px;
    padding: 12px;
    font-family: inherit;
    resize: vertical;
    font-size: 14px;
}

.admin-reply-box textarea:focus {
    outline: none;
    border-color: var(--admin-primary);
    box-shadow: 0 0 0 3px rgba(0, 80, 203, 0.1);
}

@media (max-width: 768px) {
    .admin-inbox-grid {
        grid-template-columns: 1fr;
    }

    .admin-user-list {
        max-height: 200px;
        border-right: none;
        border-bottom: 1px solid var(--admin-border);
    }
}
