# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=your_secure_password_here
DB_NAME=flixo_db

# Application environment: local | staging | production
APP_ENV=local

# System Configuration
BASE_URL=https://yourdomain.com
SYSTEM_NAME=FLIXO Escrow

# PromptPay Configuration (Payment)
PROMPTPAY_NUMBER=0937509744
PROMPTPAY_NAME=บริษัท ฟลิกโซ่ เอสโครว์ จำกัด

# External API - Slip Verification (easyslip.com)
SLIP_API_URL=https://developer.easyslip.com/api/v1/verify
SLIP_API_KEY=your_easyslip_api_key_here

# Session Configuration (optional - defaults are secure)
# SESSION_NAME=flixo_session
# SESSION_COOKIE_HTTPONLY=1
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SECURE=1  # Set to 1 in production with HTTPS

# Email Notifications
# MAIL_ENABLED=0
# MAIL_USE_PHP_MAIL=0
# MAIL_FROM_ADDRESS=noreply@yourdomain.com
# MAIL_FROM_NAME=FLIXO Escrow
# MAIL_SMTP_HOST=smtp.yourprovider.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USERNAME=your_smtp_username
# MAIL_SMTP_PASSWORD=your_smtp_password
# MAIL_SMTP_SECURE=tls

# Error Logging (auto-enabled when APP_ENV=production)
# LOG_ERRORS=1
# LOG_PATH=  # default: {project}/logs/

# Omise Payment Gateway (Sandbox: skey_test_ / pkey_test_)
# OMISE_PUBLIC_KEY=pkey_test_xxx
# OMISE_SECRET_KEY=skey_test_xxx
# OMISE_SANDBOX=1
# Webhook URL: https://yourdomain.com/api/webhook_omise.php

# Google Sign-In (GIS) — Web Client ID from Google Cloud Console
# Authorized JavaScript origins: http://localhost and your production origin (no path)
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# eKYC (Sumsub) — set EKYC_PROVIDER=sumsub when configured, else manual+selfie
# EKYC_PROVIDER=auto
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
# SUMSUB_LEVEL_NAME=id-and-liveness
# SUMSUB_WEBHOOK_SECRET=
# Webhook: https://yourdomain.com/api/webhook_ekyc.php
# EKYC_REQUIRED_FOR_SELL=0

# AI Product Image Fraud — Tier 1: EXIF (free) → Tier 2: Google Cloud Vision (suspicious only)
# IMAGE_FRAUD_PROVIDER=auto
# GOOGLE_CLOUD_VISION_API_KEY=
# IMAGE_FRAUD_BLOCK=1
# IMAGE_FRAUD_MIN_FILE_BYTES=80000
# IMAGE_FRAUD_EXIF_TRUST_THRESHOLD=65
# IMAGE_FRAUD_BLOCK_THRESHOLD=75
# IMAGE_FRAUD_FLAG_THRESHOLD=50

# AI Chat Monitoring — detect risky keywords/patterns in peer chat
# CHAT_MODERATION_ENABLED=1
# CHAT_MODERATION_BLOCK=1
# CHAT_MODERATION_BLOCK_THRESHOLD=70
# CHAT_MODERATION_FLAG_THRESHOLD=45
# Tier 2: OpenRouter AI (preferred) or Google AI Studio Gemini — suspicious messages only
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=google/gemini-2.5-flash
# GEMINI_API_KEY=
# CHAT_MODERATION_AI_ENABLED=1
# CHAT_MODERATION_AI_MIN_SCORE=25
# CHAT_MODERATION_AI_SKIP_ABOVE_SCORE=80
# CHAT_MODERATION_GEMINI_MODEL=gemini-2.0-flash

# AI Dispute Assistant — analyze chat, shipping, evidence for admin recommendation
# DISPUTE_AI_ENABLED=1
# DISPUTE_AI_MODEL=google/gemini-2.5-flash
# Uses OPENROUTER_API_KEY (or GEMINI_API_KEY); falls back to heuristic rules if unavailable

# ==========================================
# PRODUCTION CHECKLIST (required when APP_ENV=production)
# ==========================================
# FORCE_HTTPS=1
# ENCRYPTION_KEY=  # min 32 chars — generate: openssl rand -base64 32
# WEBHOOK_SECRET=  # unique secret, NOT the demo default
# SLIP_API_KEY=    # required for slip verification
# DB_PASS=         # must not be empty
# BASE_URL=        # public HTTPS URL, not localhost
#
# Validate before deploy:
#   php scripts/validate_production_config.php --strict
# Smoke test after migrations:
#   php scripts/test_e2e_flow.php

# Important Notes:
# 1. Copy this file to .env and fill in your actual values
# 2. Do NOT commit the actual .env file to version control
# 3. In production, use a secure password manager to manage these secrets
# 4. Make sure HTTPS is enabled (SLIP_API_KEY should only be sent over HTTPS)
# 5. Set proper file permissions (chmod 600 .env) in production
