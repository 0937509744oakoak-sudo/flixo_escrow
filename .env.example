# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASS=your_secure_password_here
DB_NAME=flixo_db

# Application environment: local | staging | production
APP_ENV=local

# Mock external AI/API calls for load testing (100–500 runs) without burning quota.
# When true: AiGen, Sumsub, Cloud Vision, Groq/OpenRouter/Gemini return simulated JSON
# with 500–2000ms latency — which means eKYC, chat moderation and image-fraud
# checks are FAKE. Only enable it for benchmarking; production refuses to boot
# with it on. Leave commented out for normal development against real APIs.
# MOCK_API_MODE=true
MOCK_API_MODE=false

# System Configuration
BASE_URL=https://yourdomain.com
SYSTEM_NAME=FLIXO Escrow

# Cloudinary image uploads (public product/chat/offer images)
# Create an API key/secret in Cloudinary Console > Settings > API Keys.
# On Render, add these under your Web Service > Environment.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# PromptPay Configuration (Payment)
PROMPTPAY_NUMBER=0937509744
PROMPTPAY_NAME=บริษัท ฟลิกโซ่ เอสโครว์ จำกัด

# External API - Thunder Solution Slip Verification API v2
SLIP_API_URL=https://api.thunder.in.th/v2/verify/bank
SLIP_API_KEY=your_thunder_api_key_here

# Session Configuration (optional - defaults are secure)
# SESSION_NAME=flixo_session
# SESSION_COOKIE_HTTPONLY=1
# SESSION_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SECURE=1  # Set to 1 in production with HTTPS

# Email Notifications
# MAIL_ENABLED=0
# MAIL_USE_PHP_MAIL=0
# MAIL_FROM_ADDRESS=noreply@yourdomain.com
# MAIL_FROM_NAME=FLIXO Escrow
# MAIL_SMTP_HOST=smtp.yourprovider.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USERNAME=your_smtp_username
# MAIL_SMTP_PASSWORD=your_smtp_password
# MAIL_SMTP_SECURE=tls

# Error Logging (auto-enabled when APP_ENV=production)
# LOG_ERRORS=1
# LOG_PATH=  # default: {project}/logs/

# Omise Payment Gateway (Sandbox: skey_test_ / pkey_test_)
# OMISE_PUBLIC_KEY=pkey_test_xxx
# OMISE_SECRET_KEY=skey_test_xxx
# OMISE_SANDBOX=1
# Webhook URL: https://yourdomain.com/api/webhook_omise.php

# Google Sign-In (GIS) — Web Client ID from Google Cloud Console
# Authorized JavaScript origins: http://localhost and your production origin (no path)
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Web Push (VAPID) — required for browser push notifications (needs HTTPS in production)
# Generate with: php scripts/generate_vapid_keys.php
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@yourdomain.com

# eKYC — provider: auto | manual | sumsub | aigen
# EKYC_PROVIDER=auto
# Sumsub:
# SUMSUB_APP_TOKEN=
# SUMSUB_SECRET_KEY=
# SUMSUB_LEVEL_NAME=id-and-liveness
# SUMSUB_WEBHOOK_SECRET=
# Webhook: https://yourdomain.com/api/webhook_ekyc.php
# AiGen (https://developer.aigen.online/api-keys) — Thai ID OCR + Face Compare:
# AIGEN_API_KEY=
# AIGEN_API_BASE=https://api.aigen.online
# AIGEN_FACE_THRESHOLD=80
# EKYC_REQUIRED_FOR_SELL=0

# ThaiD (DOPA Digital ID) — OpenID Connect, runs alongside EKYC_PROVIDER above.
# Register at https://digitalid.bora.dopa.go.th to receive client credentials.
# Sandbox issuer (default): https://imauthsbx.bora.dopa.go.th
# Production issuer:        https://imauth.bora.dopa.go.th
# THAID_ISSUER=https://imauthsbx.bora.dopa.go.th
# THAID_CLIENT_ID=
# THAID_CLIENT_SECRET=
# Register this exact callback URL with DOPA:
# THAID_REDIRECT_URI=http://localhost/flixo_escrow/controllers/ThaiDController.php
# THAID_SCOPE=openid pid name given_name family_name birthdate ial
# Minimum assurance level for automatic approval (2.3 = ThaiD app + chip)
# THAID_MIN_IAL=2.3
# THAID_USE_PKCE=0
# THAID_API_KEY=
# THAID_API_KEY_HEADER=Consumer-Key

# ==========================================
# Redis — real-time chat Pub/Sub (SSE). OPTIONAL: if unset or unreachable,
# ChatStream.php automatically falls back to lightweight DB polling.
# ==========================================
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=        # leave blank if your Redis has no auth
# REDIS_DB=0             # optional logical DB index
# Requires the phpredis extension (php -m | findstr redis). Without it the app
# still works via the DB-polling fallback — nothing breaks.

# ==========================================
# Cloud Object Storage (Cloudflare R2 / AWS S3) — for horizontal scaling
# ==========================================
# When these are set, uploaded images go to object storage (URL saved in DB)
# instead of local /uploads. Leave blank to keep using local disk (dev).
# Cloudflare R2 example:
#   S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev        # or your CDN/custom domain
# AWS S3 example:
#   S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
#   S3_REGION=ap-southeast-1
#   S3_PUBLIC_BASE=https://<bucket>.s3.ap-southeast-1.amazonaws.com
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE=
# Covers: chat images (public URL), product images (public URL), and payment/
# payout slips (PRIVATE — stored as an object key and streamed via an authorized
# endpoint, never a public URL). Products images can exceed 255 chars, so run
# migration 026 first: php scripts/run_migration.php 026_widen_product_image_paths_for_cloud_urls.sql
# Migrate existing local files after configuring (each is idempotent, --dry-run first):
#   php scripts/migrate_images_to_r2.php     # chat
#   php scripts/migrate_products_to_r2.php   # products.image_path + product_images
#   php scripts/migrate_slips_to_r2.php      # orders.slip_image + withdrawal payout_slip

# AI Product Image Fraud — Tier 1: EXIF (free) → Tier 2: Google Cloud Vision (suspicious only)
# IMAGE_FRAUD_PROVIDER=auto
# GOOGLE_CLOUD_VISION_API_KEY=
# IMAGE_FRAUD_BLOCK=1
# IMAGE_FRAUD_MIN_FILE_BYTES=80000
# IMAGE_FRAUD_EXIF_TRUST_THRESHOLD=65
# IMAGE_FRAUD_BLOCK_THRESHOLD=75
# IMAGE_FRAUD_FLAG_THRESHOLD=50

# AI Chat Monitoring — detect risky keywords/patterns in peer chat
# CHAT_MODERATION_ENABLED=1
# CHAT_MODERATION_BLOCK=1
# CHAT_MODERATION_BLOCK_THRESHOLD=70
# CHAT_MODERATION_FLAG_THRESHOLD=45
# Tier 2: Groq (preferred free tier) → OpenRouter → Google Gemini — suspicious messages only
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=google/gemini-2.5-flash
# GEMINI_API_KEY=
# CHAT_MODERATION_AI_ENABLED=1
# CHAT_MODERATION_AI_MIN_SCORE=25
# CHAT_MODERATION_AI_SKIP_ABOVE_SCORE=80
# Soft escalation for low-score bait (payment-confirm, OCR variants, anonymized PII). Default ON.
# CHAT_MODERATION_SOFT_TRIGGER=1
# CHAT_MODERATION_GEMINI_MODEL=gemini-2.0-flash
# CHAT_MODERATION_GROQ_MODEL=llama-3.3-70b-versatile
# Cascaded moderation telemetry (JSONL under logs/ + optional DB table)
# CHAT_MODERATION_TELEMETRY_ENABLED=1
# CHAT_MODERATION_TELEMETRY_DB=1
# CHAT_MODERATION_TELEMETRY_SALT=change-me-to-random-string
# CHAT_MODERATION_COST_GROQ_PER_M=0.70
# CHAT_MODERATION_COST_OPENROUTER_PER_M=0.30
# CHAT_MODERATION_COST_GEMINI_PER_M=0.20

# AI Dispute Assistant — analyze chat, shipping, evidence for admin recommendation
# DISPUTE_AI_ENABLED=1
# DISPUTE_AI_GROQ_MODEL=llama-3.3-70b-versatile
# DISPUTE_AI_MODEL=llama-3.3-70b-versatile
# Uses GROQ_API_KEY (preferred), then OPENROUTER_API_KEY / GEMINI_API_KEY; falls back to heuristic

# ==========================================
# PRODUCTION CHECKLIST (required when APP_ENV=production)
# ==========================================
# FORCE_HTTPS=1
# ENCRYPTION_KEY=  # min 32 chars — generate: openssl rand -base64 32
# WEBHOOK_SECRET=  # unique secret, NOT the demo default
# SLIP_API_KEY=    # required for slip verification
# DB_PASS=         # must not be empty
# BASE_URL=        # public HTTPS URL, not localhost
#
# Validate before deploy:
#   php scripts/validate_production_config.php --strict
# Smoke test after migrations:
#   php scripts/test_e2e_flow.php

# Important Notes:
# 1. Copy this file to .env and fill in your actual values
# 2. Do NOT commit the actual .env file to version control
# 3. In production, use a secure password manager to manage these secrets
# 4. Make sure HTTPS is enabled (SLIP_API_KEY should only be sent over HTTPS)
# 5. Set proper file permissions (chmod 600 .env) in production
